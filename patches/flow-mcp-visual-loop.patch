index 0000000..7030a78
--- /dev/null
+++ b/src/music.ts
@@ -0,0 +1,205 @@
+import { copyFileSync, existsSync, mkdirSync, readdirSync, rmSync, statSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+import type { Locator, Page } from "playwright-core";
+import { HOME_DIR, MUSIC_URL, getMusicPage } from "./chrome.js";
+import type { Job } from "./queue.js";
+
+const DOWNLOAD_DIR = join(HOME_DIR, "downloads");
+const SYSTEM_DOWNLOADS = join(homedir(), "Downloads");
+const MUSIC_TIMEOUT_MS = 4 * 60_000;
+const DOWNLOAD_TIMEOUT_MS = 45_000;
+
+const pause = (page: Page, ms: number) => page.waitForTimeout(ms);
+
+async function useOwnDownloadDir(page: Page): Promise<void> {
+  mkdirSync(DOWNLOAD_DIR, { recursive: true });
+  const cdp = await page.context().newCDPSession(page);
+  await cdp.send("Browser.setDownloadBehavior", {
+    behavior: "allowAndName",
+    downloadPath: DOWNLOAD_DIR,
+    eventsEnabled: true,
+  });
+}
+
+function downloadsNow(): Set<string> {
+  const seen = new Set<string>();
+  for (const dir of [DOWNLOAD_DIR, SYSTEM_DOWNLOADS]) {
+    if (existsSync(dir)) for (const f of readdirSync(dir)) seen.add(`${dir}/${f}`);
+  }
+  return seen;
+}
+
+async function waitForDownloadedFile(page: Page, before: Set<string>, timeoutMs: number): Promise<string> {
+  const deadline = Date.now() + timeoutMs;
+  let stable: { path: string; size: number } | undefined;
+  while (Date.now() < deadline) {
+    await pause(page, 300);
+    for (const dir of [DOWNLOAD_DIR, SYSTEM_DOWNLOADS]) {
+      if (!existsSync(dir)) continue;
+      for (const f of readdirSync(dir)) {
+        const full = join(dir, f);
+        if (before.has(`${dir}/${f}`) || f.endsWith(".crdownload") || f.startsWith(".")) continue;
+        const size = statSync(full).size;
+        if (stable?.path === full && stable.size === size && size > 0) return full;
+        stable = { path: full, size };
+      }
+    }
+  }
+  throw new Error("Flow Music started the download but no audio file arrived in ~/.flow-mcp/downloads or ~/Downloads.");
+}
+
+async function setSwitch(sw: Locator, want: boolean): Promise<void> {
+  await sw.waitFor({ state: "visible", timeout: 10_000 });
+  const checked = (await sw.getAttribute("aria-checked")) === "true" || (await sw.getAttribute("data-state")) === "checked";
+  if (checked !== want) await sw.click();
+}
+
+async function ensureSignedIn(page: Page): Promise<void> {
+  const url = page.url();
+  if (/accounts\.google\.com/.test(url)) {
+    throw new Error("Google Flow Music is not signed in. Sign in to https://www.flowmusic.app/ in the Flow Chrome window, then retry.");
+  }
+  const loginBtn = page.getByRole("button", { name: /^(Log in|Sign up|登录|免费注册)$/i }).first();
+  if (await loginBtn.isVisible().catch(() => false)) {
+    throw new Error("Google Flow Music is not signed in. Click Log in on https://www.flowmusic.app/ in the Flow Chrome window, then retry.");
+  }
+}
+
+async function downloadFromMoreButton(
+  page: Page,
+  moreBtn: Locator,
+  format: "mp3" | "wav" | "m4a",
+  destPath: string,
+): Promise<string> {
+  await useOwnDownloadDir(page);
+  const before = downloadsNow();
+
+  await page.keyboard.press("Escape");
+  await pause(page, 200);
+  await moreBtn.click({ timeout: 10_000 });
+  await pause(page, 500);
+
+  const dlMenu = page.getByRole("menuitem", { name: /^Download$/i }).first();
+  await dlMenu.waitFor({ state: "visible", timeout: 8_000 });
+  await dlMenu.hover();
+  await pause(page, 500);
+
+  const fmtLabel = format.toUpperCase();
+  const fmtItem = page.getByRole("menuitem", { name: new RegExp(`^${fmtLabel}$`, "i") }).first();
+  await fmtItem.waitFor({ state: "visible", timeout: 8_000 });
+  // Radix UI submenus reliably trigger on keyboard Enter even when Chrome is in the background.
+  await fmtItem.focus();
+  await page.keyboard.press("Enter");
+
+  const downloaded = await waitForDownloadedFile(page, before, DOWNLOAD_TIMEOUT_MS);
+  copyFileSync(downloaded, destPath);
+  rmSync(downloaded, { force: true });
+  return destPath;
+}
+
+export async function runMusicGeneration(job: Job): Promise<string[]> {
+  const page = await getMusicPage();
+  const format = job.params.music_format ?? "mp3";
+  const instrumental = Boolean(job.params.music_instrumental);
+
+  job.progress = "Opening Flow Music session";
+  await page.goto(MUSIC_URL, { waitUntil: "domcontentloaded", timeout: 30_000 });
+  await pause(page, 1800);
+  await ensureSignedIn(page);
+
+  // Open Compose panel if not already expanded
+  const soundBox = page.locator('textarea[aria-label="Sound description"]');
+  if (!(await soundBox.isVisible().catch(() => false))) {
+    const toggle = page.getByRole("button", { name: /Toggle compose panel|Open compose panel/i }).first();
+    await toggle.waitFor({ state: "visible", timeout: 15_000 });
+    await toggle.click();
+    await soundBox.waitFor({ state: "visible", timeout: 10_000 });
+  }
+
+  // Configure switches and text inputs
+  await setSwitch(page.locator('button[aria-label="Toggle instrumental mode"]'), instrumental);
+  await pause(page, 300);
+
+  if (job.params.music_advanced !== undefined) {
+    const advSwitch = page.locator('button[aria-label="Toggle advanced sound mode"]');
+    if (await advSwitch.isVisible().catch(() => false)) {
+      await setSwitch(advSwitch, job.params.music_advanced);
+      await pause(page, 300);
+    }
+  }
+
+  if (!instrumental) {
+    const lyricsBox = page.locator('textarea[aria-label="Lyrics"]');
+    if (await lyricsBox.isVisible().catch(() => false)) {
+      await lyricsBox.fill(job.params.music_lyrics ?? "");
+    }
+  }
+
+  await soundBox.fill(job.params.prompt);
+  await pause(page, 400);
+
+  const genBtn = page.getByRole("button", { name: /^Generate$/i }).first();
+  await genBtn.waitFor({ state: "visible", timeout: 10_000 });
+  if (await genBtn.isDisabled()) {
+    throw new Error("Flow Music Generate button is disabled; check prompt length or account quota.");
+  }
+
+  job.progress = "Generating track in Flow Music (Lyria 3.5)";
+  await genBtn.click();
+
+  // Wait for generated song card(s) to appear and finish generating
+  const deadline = Date.now() + MUSIC_TIMEOUT_MS;
+  let uniqueSongIds: string[] = [];
+  while (Date.now() < deadline) {
+    await pause(page, 3000);
+    const snap = await page.evaluate(() => {
+      const clean = (s: string | null | undefined) => (s || "").replace(/\s+/g, " ").trim();
+      const ids = new Set<string>();
+      for (const a of document.querySelectorAll('a[href^="/song/"]')) {
+        const m = (a.getAttribute("href") || "").match(/^\/song\/([0-9a-f-]+)/i);
+        if (m) ids.add(m[1]);
+      }
+      const moreCount = document.querySelectorAll('button[aria-label^="More options for"]').length;
+      const body = clean(document.body?.innerText);
+      const generating = /\b(generating|creating|composing)\b/i.test(body);
+      const errMatch = body.match(/(out of credits|quota exceeded|rate limit|something went wrong|failed to generate[^.!\n]*)/i);
+      return { ids: [...ids], moreCount, generating, error: errMatch?.[0] ?? null };
+    });
+    if (snap.error) throw new Error(`Flow Music reported an error: ${snap.error}`);
+    if (snap.ids.length > 0 && snap.moreCount > 0 && !snap.generating) {
+      uniqueSongIds = snap.ids;
+      break;
+    }
+  }
+
+  if (!uniqueSongIds.length) {
+    throw new Error("Timed out waiting for Flow Music to finish generating the track.");
+  }
+
+  // Let the finished song settle before triggering download
+  await pause(page, 2000);
+  mkdirSync(job.params.output_dir, { recursive: true });
+
+  const saved: string[] = [];
+  for (let i = 0; i < uniqueSongIds.length; i++) {
+    const songId = uniqueSongIds[i];
+    const suffix = uniqueSongIds.length > 1 ? `-v${i + 1}` : "";
+    const dest = join(job.params.output_dir, `${job.params.file_stem}${suffix}.${format}`);
+    job.progress = `Downloading track ${i + 1}/${uniqueSongIds.length} (${format.toUpperCase()})`;
+
+    // Match the More options button inside the card carrying this songId, falling back to nth/first.
+    const cardMore = page
+      .locator(`:has(> a[href="/song/${songId}"]), :has(a[href="/song/${songId}"])`)
+      .locator('button[aria-label^="More options for"]')
+      .first();
+    const targetBtn = (await cardMore.isVisible().catch(() => false))
+      ? cardMore
+      : page.locator('button[aria-label^="More options for"]').nth(i);
+
+    saved.push(await downloadFromMoreButton(page, targetBtn, format, dest));
+  }
+
+  job.note = `Lyria 3.5 (${format.toUpperCase()}), song_ids: ${uniqueSongIds.join(", ")}`;
+  return saved;
+}
